# Security headers for every path (theprinceecho.com, Cloudflare Pages).
# HSTS is set at the Cloudflare zone, so it is not repeated here.
# CSP: inline scripts are allowed only by sha256 hash. If you edit an inline
# <script> block, recompute its hash and update script-src, or it will not run.
# Hashes: index.html (2 blocks), contact.html (1), footer year script (shared).
# frame-src tally.so is for the click-to-load contact form.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-Du+OJKJSbdUgz5nrHeWWINvez6XKDDU/tyj/5c2uvwo=' 'sha256-X0WsWzKvV/ikioA34oo4n1VK4avg3mtKX2m+PF7K56M=' 'sha256-HcgzxZbPAZpohGxHm2nEO80s3IWiRGSoZ30S2hzmYNM=' 'sha256-XzgUe5OFqmw92fRcUj4AjwYpGUNdPyxTpzMkUICgemM='; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://tally.so; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; manifest-src 'self'; upgrade-insecure-requests
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin

# HTML — always revalidate so content updates appear promptly
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/contact.html
  Cache-Control: public, max-age=0, must-revalidate

/legal.html
  Cache-Control: public, max-age=0, must-revalidate

/privacy.html
  Cache-Control: public, max-age=0, must-revalidate

/de/*
  Cache-Control: public, max-age=0, must-revalidate

# Shared CSS — short cache; avoid immutable pin after polish deploys
/assets/css/*
  Cache-Control: public, max-age=3600, must-revalidate

# Images and other static assets — long cache
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable
